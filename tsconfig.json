{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@adapters/*": ["./src/adapters/*"],
			"@core/*": ["./src/core/*"],
			"@presentation/*": ["./src/presentation/*"],
			"src/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["vite/client"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.d.ts",
		"tests/**/*.ts",
		"vitest.config.ts",
		"worker-configuration.d.ts"
	]
}
